# Copy to .env and fill in. .env is gitignored — never commit real keys.

# LLM provider for the Phase 2 agent loop. Only one is needed.
# Anthropic Claude API:
ANTHROPIC_API_KEY=

# If using a local model via Ollama instead, no key is required; set the host:
# OLLAMA_HOST=http://localhost:11434

# Optional: directory the notes server is allowed to read.
# Defaults to servers/notes_server/notes_data if unset.
# NOTES_DIR=/absolute/path/to/your/notes
